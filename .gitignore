# Project artifacts (generated, mostly ignored). We selectively
# whitelist small summaries / the rendered HTML / the Phase 6.2
# headline-result checkpoints so they are directly readable on GitHub.
# Order matters: git applies later rules over earlier ones, but
# negations cannot un-exclude a child of a fully-excluded directory.
# So we ignore at the file-glob level, then re-include specific paths.
*.ckpt
*.swp

# Ignore everything at runs/ level
runs/*

# Re-include small summaries for direct readability on GitHub. The
# top-level pattern catches summaries written directly under runs/;
# the explicit polygram entry re-includes the bridge's nested summary
# so future regens land without needing `git add -f` and the published
# docs/index.html stays in sync with what scripts/visualize.py reads.
!runs/*_summary.json
!runs/polygram/polygram_summary.json

# Re-include the Phase 6.2 unified-recipe artifacts: the headline
# "6/6 regime in a single run" result. World-model + 3 SAE checkpoints
# total ~7 MB; the 86 MB activations npz stays ignored (regeneratable
# in ~3 minutes via scripts/regime_dual_head_experiment.py).
!runs/world_model_regime_dual_head.pt
!runs/regime_dual_head_experiment/

# Inside the un-ignored subdir, re-apply per-file ignore then negate .pt
runs/regime_dual_head_experiment/*
!runs/regime_dual_head_experiment/*.pt

# Forge pipeline outputs. forge_results.json (summary) and the
# compressed safetensors are useful to share; the input safetensors
# is regeneratable from the SAE .pt, and the 2.4 MB validation
# report is regeneratable raw pairwise stats.
!runs/forge/
!runs/forge/**
runs/forge/**/sae.safetensors
runs/forge/**/validation_report.json

# Generated data bundles -- checked in by default so the repo is usable
# without running scripts/build_data.py first. Comment these in to track
# only the build scripts:
# data/*.npz
# data/*.safetensors

# OS junk
Thumbs.db
*.swp
